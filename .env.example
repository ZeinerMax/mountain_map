# Copy to .env and fill in. NEVER commit .env.
# MapTiler Cloud key (terrain + satellite base): https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_KEY=
# Tracestrack Maps key (Topo overlay): https://console.tracestrack.com/ (sign in to the console)
VITE_TRACESTRACK_KEY=
# Overpass endpoint for hut search (optional; default is the public FOSSGIS instance)
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter
